{
  "environments": [
    {
      "id": "local-full-stack",
      "name": "フルスタック検証環境",
      "processes": [
        {
          "id": "db",
          "label": "PostgreSQL",
          "command": "docker compose up db",
          "cwd": "~/projects/myapp",
          "env": {
            "POSTGRES_PASSWORD": "secret"
          },
          "depends_on": []
        },
        {
          "id": "backend",
          "label": "Rails API",
          "command": "bundle exec rails s",
          "cwd": "~/projects/myapp",
          "port": 3000,
          "env": {
            "RAILS_ENV": "development"
          },
          "depends_on": ["db"]
        }
      ],
      "worktree": {
        "enabled": false,
        "repo_path": "",
        "branch": ""
      }
    },
    {
      "id": "devhub-verify",
      "name": "devhub 検証環境",
      "processes": [
        {
          "id": "devhub",
          "label": "devhub (検証インスタンス)",
          "command": "./start.sh --no-browser",
          "cwd": "~/path/to/devhub",
          "port": 8765,
          "port_strategy": "offset",
          "port_env_var": "DEVHUB_PORT",
          "depends_on": []
        }
      ],
      "worktree": {
        "enabled": false,
        "repo_path": "",
        "branch": ""
      }
    },
    {
      "id": "cli-port-verify",
      "name": "CLI ポート指定アプリの検証例",
      "processes": [
        {
          "id": "app",
          "label": "ポートを CLI 引数で受けるアプリ（command 内の {{port}} を offset 割当ポートに置換）",
          "command": "myapp --port {{port}}",
          "cwd": "~/projects/myapp",
          "port": 3000,
          "port_strategy": "offset",
          "port_env_var": "PORT",
          "depends_on": []
        }
      ],
      "worktree": {
        "enabled": false,
        "repo_path": "",
        "branch": ""
      }
    }
  ]
}
